      "http://localhost:4200",
      "http://10.20.0.6",
      "http://localhost:12980",
      "http://localhost:56641",
      "http://localhost:25228",

      // An origin is scheme + host + port and nothing else. This entry read
      // "https://testerp.atcolab.com/DMSCOREAPI/", and WithOrigins compares the
      // string exactly, so it could never match the Origin header a browser
      // actually sends ("https://testerp.atcolab.com").
      "https://testerp.atcolab.com",

      // The local UI runs on 30228. localhost and 127.0.0.1 are different
      // origins to a browser even though they are the same machine, so both are
      // listed - whichever one the address bar says has to match.
      "http://localhost:30228",
      "http://127.0.0.1:30228"
    ],
