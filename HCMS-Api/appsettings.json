  // DMS AI features: the rich text editor's proofreading action, and the AI Report assistant.
  //
  // The model runs ON-PREMISES (the same gateway Stride uses) -- no document text goes to a
  // third-party service. CertificateSha256 is required: the gateway serves a self-signed
  // certificate, and the provider pins it rather than disabling validation. Leave any of
  // BaseUrl / ApiKey / Model / CertificateSha256 empty and the feature reports itself
  // unconfigured instead of running unprotected.
  //
  // AllowDocumentContent is OFF by design. Document numbers, titles, statuses, versions and
  // review dates are always available to the assistant; the document BODY is not, until the
  // document owner decides it should be. These are controlled documents -- the SOP template's
  // own footer says "confidential and private".
  "Ai": {
    "Gateway": {
      "Enabled": true,
      "BaseUrl": "https://10.10.0.110:8443/v1",
      "ApiKey": "84f55dec156b2c20553216740a2c20444b6c83cf34be4bbc2b2ac21ad0422910",
      "Model": "google/gemma-4-e4b",
      "CertificateSha256": "865FC63F02D8F892B7A5724EE75C74A20770EEE15958299D2E81887D6E1320A3",
      "TimeoutSeconds": 180,
      "PolicyDirectory": "AiPolicies",
      "ReasoningEffort": "none",
      "MaxOutputTokens": 4000,
      "MaxContextCharacters": 12000,
      "MaxContextDocuments": 25,
      "MaxQuestionCharacters": 2000,
      "MaxProofreadCharacters": 10000,
      "GlobalConcurrency": 4,
      "AllowDocumentContent": false
    }
