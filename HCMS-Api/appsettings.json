  // DMS AI features: the rich text editor's proofreading action, and the AI Report assistant.
  //
  // The model is Qwen 3.5 Plus on Alibaba Cloud Model Studio (international endpoint), reached through its
  // OpenAI-compatible API. This is a HOSTED service: the prompt -- including any document text the assistant is
  // allowed to read, see AllowDocumentContent -- leaves the network.
  //
  // ApiKey is deliberately EMPTY here and must never be committed. Provide it as the environment variable
  // Ai__Gateway__ApiKey (UAT / production) or with: dotnet user-secrets set "Ai:Gateway:ApiKey" "<key>"
  // (local development). Leave BaseUrl / ApiKey / Model empty and the feature reports itself unconfigured.
  //
  // CertificateSha256 is empty because the endpoint has an ordinary public certificate (normal validation
  // applies). It is only for a self-signed endpoint such as the old on-premises gateway.
  //
  // EnableThinking is false: Qwen 3.5 thinks by default, and thinking tokens come out of MaxOutputTokens.
  // JsonResponseFormat is "json_object": Model Studio accepts a strict json_schema but does not enforce it
  // (verified), whereas JSON mode with the schema in the prompt returns the requested shape.
  //
  // AllowDocumentContent: Document numbers, titles, statuses, versions and review dates are always available
  // to the assistant; the document BODY is only sent when this is true. These are controlled documents -- the
  // SOP template's own footer says "confidential and private" -- so with a hosted model this is a decision for
  // the document owner.
  "Ai": {
    "Gateway": {
      "Enabled": true,
      "BaseUrl": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
      "ApiKey": "",
      "Model": "qwen3.5-plus-2026-04-20",
      "CertificateSha256": "",
      "TimeoutSeconds": 120,
      "PolicyDirectory": "AiPolicies",
      "ReasoningEffort": "",
      "EnableThinking": false,
      "JsonResponseFormat": "json_object",
      "MaxOutputTokens": 4000,
      "MaxContextCharacters": 12000,
      "MaxContextDocuments": 25,
      "MaxQuestionCharacters": 2000,
      "MaxProofreadCharacters": 10000,
      "GlobalConcurrency": 4,
      "AllowDocumentContent": true
    }
  },

